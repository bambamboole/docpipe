{
  "openapi": "3.1.0",
  "info": {
    "title": "docpipe",
    "description": "Analyses invoices and quotes in German and English: PDF classification, the text of every page, OCR of scanned pages, embedded ZUGFeRD/Factur-X and XRechnung XML, and field candidates for a person to confirm. The service is stateless and keeps nothing it receives.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "{base_url}",
      "description": "A docpipe instance",
      "variables": {
        "base_url": {
          "default": "http://localhost:8080",
          "description": "Where docpipe runs"
        }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health check",
        "description": "Answers `ok` while the service runs. It needs no token.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service runs.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "ok"
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/v1/analyze": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Analyse a document",
        "description": "Takes a PDF or a standalone CII/UBL e-invoice XML as the raw request body.\nText-based pages are read from their text layer; pages without one go to\nOCR, one document at a time. Candidates are proposals: a field that cannot\nbe read with confidence is `null`.",
        "operationId": "analyze_document",
        "requestBody": {
          "description": "The document as the raw body, at most `DOCPIPE_MAX_BODY_MB` megabytes.",
          "content": {
            "application/pdf": {},
            "application/xml": {},
            "text/xml": {}
          }
        },
        "responses": {
          "200": {
            "description": "The analysis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "400": {
            "description": "The body is empty (`empty_body`) or could not be read (`unreadable_body`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing or invalid (`unauthorized`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "The body exceeds `DOCPIPE_MAX_BODY_MB` (`payload_too_large`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "The body is neither a PDF nor a CII/UBL e-invoice XML (`unsupported_format`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The PDF cannot be read (`unreadable_pdf`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "The analysis failed (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The issuer's keys cannot be fetched (`auth_unavailable`), more than `DOCPIPE_MAX_CONCURRENT` plus `DOCPIPE_MAX_QUEUED` requests are in flight (`overloaded`), or no analysis slot freed up or the analysis did not finish within `DOCPIPE_TIMEOUT_SECS` (`timeout`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Amounts": {
        "type": "object",
        "description": "The document's totals. Without tax lines that add up to a gross amount,\nonly labelled amounts are returned.",
        "required": [
          "consistent",
          "currency",
          "gross",
          "net",
          "tax",
          "tax_lines"
        ],
        "properties": {
          "consistent": {
            "type": "boolean",
            "description": "Whether the tax lines add up to the gross amount on the document."
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ISO 4217 code of the currency the amounts are written in, when the\ndocument names one unambiguously next to its amounts."
          },
          "gross": {
            "type": [
              "string",
              "null"
            ],
            "description": "The gross amount, written like `net`."
          },
          "net": {
            "type": [
              "string",
              "null"
            ],
            "description": "The net amount as a decimal string with a dot and two fraction\ndigits, e.g. `3250.00`."
          },
          "tax": {
            "type": [
              "string",
              "null"
            ],
            "description": "The tax amount, written like `net`."
          },
          "tax_lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxLine"
            },
            "description": "The net and tax amount per tax rate, ordered by rate. Only rates the\ndocument prints are used."
          }
        }
      },
      "Analysis": {
        "type": "object",
        "description": "The analysis of one document.",
        "required": [
          "attachments",
          "candidates",
          "einvoice",
          "format",
          "ocr",
          "page_count",
          "pages",
          "pages_needing_ocr",
          "pdf_type",
          "processing_ms",
          "text_source"
        ],
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentInfo"
            },
            "description": "The files embedded in the PDF."
          },
          "candidates": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Candidates",
                "description": "Field candidates; `null` without text (XML, or OCR off or failed)."
              },
              {
                "type": "null"
              }
            ]
          },
          "einvoice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EInvoice",
                "description": "The e-invoice XML embedded in the PDF, or the standalone XML document."
              },
              {
                "type": "null"
              }
            ]
          },
          "format": {
            "$ref": "#/components/schemas/Format",
            "description": "What was sent."
          },
          "ocr": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OcrReport",
                "description": "What OCR did; `null` for XML."
              },
              {
                "type": "null"
              }
            ]
          },
          "page_count": {
            "type": "integer",
            "format": "int32",
            "description": "`0` for XML.",
            "minimum": 0
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            },
            "description": "Every page, in order."
          },
          "pages_needing_ocr": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "1-indexed numbers of the pages without a usable text layer."
          },
          "pdf_type": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PdfType",
                "description": "The PDF's classification; `null` for XML."
              },
              {
                "type": "null"
              }
            ]
          },
          "processing_ms": {
            "type": "integer",
            "format": "int64",
            "description": "How long the analysis took, waiting for OCR included.",
            "minimum": 0
          },
          "text_source": {
            "$ref": "#/components/schemas/TextSource",
            "description": "Where the text of `pages` comes from."
          }
        }
      },
      "AttachmentInfo": {
        "type": "object",
        "description": "A file embedded in the PDF.",
        "required": [
          "filename",
          "mime_type",
          "size"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "description": "The name the PDF gives the file."
          },
          "mime_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "The MIME type the PDF declares, when it does."
          },
          "size": {
            "type": "integer",
            "description": "Size in bytes.",
            "minimum": 0
          }
        }
      },
      "Candidates": {
        "type": "object",
        "description": "Field candidates of an invoice or quote, for a person to confirm. A\nfield that cannot be read with confidence is `null`.",
        "required": [
          "amounts",
          "document_kind",
          "due_date",
          "ibans",
          "invoice_kind",
          "issue_date",
          "line_items",
          "number",
          "profile",
          "seller_name",
          "valid_until",
          "vat_ids"
        ],
        "properties": {
          "amounts": {
            "$ref": "#/components/schemas/Amounts",
            "description": "The document's totals."
          },
          "document_kind": {
            "$ref": "#/components/schemas/DocumentKind",
            "description": "Whether the document is an invoice, a quote, a credit note or none."
          },
          "due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Field",
                "description": "The date an invoice is payable by."
              },
              {
                "type": "null"
              }
            ]
          },
          "ibans": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IBANs without spaces, checked with their ISO 13616 check digits."
          },
          "invoice_kind": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/InvoiceKind",
                "description": "Only for invoices."
              },
              {
                "type": "null"
              }
            ]
          },
          "issue_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Field",
                "description": "The date the document was issued."
              },
              {
                "type": "null"
              }
            ]
          },
          "line_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "description": "The positions of the document; empty when it has fewer than two."
          },
          "number": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Field",
                "description": "The invoice or quote number."
              },
              {
                "type": "null"
              }
            ]
          },
          "profile": {
            "type": "string",
            "description": "The language profile the document was read with, detected from its\nwords, e.g. `de` or `en`."
          },
          "seller_name": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Field",
                "description": "The issuing company, by its name with a legal form."
              },
              {
                "type": "null"
              }
            ]
          },
          "valid_until": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Field",
                "description": "The end of a quote's validity."
              },
              {
                "type": "null"
              }
            ]
          },
          "vat_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "VAT identification numbers of EU countries, the United Kingdom,\nSwitzerland and Norway, without spaces, dots or dashes."
          }
        }
      },
      "DocumentKind": {
        "type": "string",
        "description": "What the document is, judged by its title and labels.",
        "enum": [
          "invoice",
          "quote",
          "credit_note",
          "other"
        ]
      },
      "EInvoice": {
        "type": "object",
        "description": "An e-invoice XML document, returned as is.",
        "required": [
          "filename",
          "syntax",
          "xml"
        ],
        "properties": {
          "filename": {
            "type": [
              "string",
              "null"
            ],
            "description": "The attachment's file name, or `null` for a standalone XML document."
          },
          "syntax": {
            "$ref": "#/components/schemas/EInvoiceSyntax",
            "description": "Which of the two e-invoice syntaxes the document uses."
          },
          "xml": {
            "type": "string",
            "description": "The XML as embedded or sent, unparsed."
          }
        }
      },
      "EInvoiceSyntax": {
        "type": "string",
        "description": "The syntax of an e-invoice XML document.",
        "enum": [
          "cii",
          "ubl"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "An error answer.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "A sentence for people; match on `error` instead."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "The error codes of the API.",
        "enum": [
          "unauthorized",
          "auth_unavailable",
          "empty_body",
          "unreadable_body",
          "payload_too_large",
          "unsupported_format",
          "unreadable_pdf",
          "timeout",
          "overloaded",
          "internal_error"
        ]
      },
      "Field": {
        "type": "object",
        "description": "A value and where it was read.",
        "required": [
          "line",
          "page",
          "value"
        ],
        "properties": {
          "line": {
            "type": "string",
            "description": "The line the value was read from."
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "1-indexed page number.",
            "minimum": 0
          },
          "value": {
            "type": "string",
            "description": "The normalized value; dates as `YYYY-MM-DD`."
          }
        }
      },
      "Format": {
        "type": "string",
        "description": "The kind of document that was sent.",
        "enum": [
          "pdf",
          "xml"
        ]
      },
      "InvoiceKind": {
        "type": "string",
        "description": "A standard, partial (`Abschlagsrechnung`, `Teilrechnung`) or final\n(`Schlussrechnung`) invoice.",
        "enum": [
          "standard",
          "partial",
          "final"
        ]
      },
      "LineItem": {
        "type": "object",
        "description": "One position of a quote or invoice.",
        "required": [
          "description",
          "optional",
          "page",
          "position",
          "quantity",
          "section",
          "tax_rate",
          "total",
          "unit",
          "unit_price"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "The position's text, its lines joined with spaces."
          },
          "optional": {
            "type": "boolean",
            "description": "An optional, alternative or contingency position, which is not part of\nthe document's total."
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "1-indexed page number of the position's first line.",
            "minimum": 0
          },
          "position": {
            "type": "string",
            "description": "The position number as printed, e.g. `1.2` or `10073`."
          },
          "quantity": {
            "type": [
              "string",
              "null"
            ],
            "description": "Decimal string with a dot, e.g. `82.45`; `1` for a lump sum."
          },
          "section": {
            "type": [
              "string",
              "null"
            ],
            "description": "The heading of the title or group the position belongs to."
          },
          "tax_rate": {
            "type": [
              "string",
              "null"
            ],
            "description": "The tax rate in percent printed on the position, e.g. `19` or `7.5`,\nwhen it is one of the rates of the document's tax lines."
          },
          "total": {
            "type": [
              "string",
              "null"
            ],
            "description": "The position's total, written like `unit_price`."
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "The unit as printed, e.g. `m²`, `Stk` or `pauschal`."
          },
          "unit_price": {
            "type": [
              "string",
              "null"
            ],
            "description": "The price of one unit, as a decimal string with a dot and two\nfraction digits."
          }
        }
      },
      "OcrPage": {
        "type": "object",
        "description": "A page read by OCR.",
        "required": [
          "confidence",
          "markdown",
          "number",
          "weak"
        ],
        "properties": {
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "The recognizer's mean confidence. It stays high even on poor scans and\nis no quality gate."
          },
          "markdown": {
            "type": "string",
            "description": "The page as Markdown, tables included."
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "description": "1-indexed page number.",
            "minimum": 0
          },
          "weak": {
            "type": "boolean",
            "description": "Whether pdf-inspector suggests a stronger document parser for the page."
          }
        }
      },
      "OcrReport": {
        "type": "object",
        "description": "What OCR did for the pages without a usable text layer.",
        "required": [
          "error",
          "ocr_ms",
          "pages",
          "render_ms",
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why OCR failed, in one short sentence; the native result is returned\ninstead."
          },
          "ocr_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Time spent recognizing the rendered pages.",
            "minimum": 0
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OcrPage"
            },
            "description": "The pages OCR read; empty unless `status` is `applied`."
          },
          "render_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Time spent rendering the pages.",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/OcrStatus",
            "description": "Whether OCR ran."
          }
        }
      },
      "OcrStatus": {
        "type": "string",
        "description": "Whether OCR ran.",
        "enum": [
          "not_needed",
          "disabled",
          "applied",
          "failed"
        ]
      },
      "Page": {
        "type": "object",
        "description": "One page of a PDF.",
        "required": [
          "markdown",
          "needs_ocr",
          "number",
          "ocr",
          "text"
        ],
        "properties": {
          "markdown": {
            "type": "string",
            "description": "The page as Markdown, with tables and headings."
          },
          "needs_ocr": {
            "type": "boolean",
            "description": "Whether the page has no usable text layer."
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "description": "1-indexed.",
            "minimum": 0
          },
          "ocr": {
            "type": "boolean",
            "description": "Whether `text` and `markdown` come from OCR."
          },
          "text": {
            "type": "string",
            "description": "The page's lines, top to bottom."
          }
        }
      },
      "PdfType": {
        "type": "string",
        "description": "pdf-inspector's classification of a PDF.",
        "enum": [
          "text_based",
          "scanned",
          "image_based",
          "mixed"
        ]
      },
      "TaxLine": {
        "type": "object",
        "description": "The net and tax amount of one tax rate.",
        "required": [
          "net",
          "rate",
          "tax"
        ],
        "properties": {
          "net": {
            "type": "string",
            "description": "The net amount taxed at the rate, as a decimal string with a dot and\ntwo fraction digits."
          },
          "rate": {
            "type": "string",
            "description": "The rate in percent as printed, e.g. `19`, `7.5` or `8.1`."
          },
          "tax": {
            "type": "string",
            "description": "The tax on `net`, written like it."
          }
        }
      },
      "TextSource": {
        "type": "string",
        "description": "Where the pages' text comes from.",
        "enum": [
          "native",
          "ocr",
          "mixed",
          "none"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "With `AUTH_MODE=jwt` an RS256 access token of the configured issuer, with `AUTH_MODE=api_key` the static API key. With `AUTH_MODE=none` no token is required."
      }
    }
  },
  "tags": [
    {
      "name": "analysis",
      "description": "Document analysis"
    },
    {
      "name": "operations",
      "description": "Health checks"
    }
  ]
}
